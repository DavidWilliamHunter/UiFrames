<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="FramesDemo.uss" />
    <ui:VisualElement name="screen" class="screen">
        <ui:VisualElement class="header">
            <ui:Label text="UI Frames: UI Toolkit" class="title" />
            <ui:Label name="status" text="" class="status" />
        </ui:VisualElement>
        <ui:Label class="help" text="Mouse: drag a frame (also from its buttons), wheel to scroll, click the ≡ handle. Keyboard/gamepad: arrows/d-pad or Tab choose, Enter/A goes in (frame → card → control; Enter presses a button, or starts/stops adjusting a slider), Esc/B comes back out. Page Up/Down, Home/End, F6 jumps to the next frame; Y toggles the drawer." />

        <ui:Label class="section" text="Card strip: inertia, snaps to cards (.uf-card-strip, --uf-snap: card)" />
        <ui:VisualElement name="photos" class="uf-card-strip photos">
            <ui:VisualElement class="uf-cards">
                <ui:VisualElement name="Card 1" class="card"><ui:Label text="1" class="card-title" /><ui:Button name="press-1" text="Press" /></ui:VisualElement>
                <ui:VisualElement name="Card 2" class="card"><ui:Label text="2" class="card-title" /><ui:Button name="press-2" text="Press" /></ui:VisualElement>
                <ui:VisualElement name="Card 3" class="card"><ui:Label text="3: slider keeps its drag" class="card-title" /><ui:Slider low-value="0" high-value="10" value="5" /></ui:VisualElement>
                <ui:VisualElement name="Card 4" class="card"><ui:Label text="4" class="card-title" /><ui:Button name="press-4" text="Press" /></ui:VisualElement>
                <ui:VisualElement name="Card 5" class="card"><ui:Label text="5" class="card-title" /><ui:Toggle label="Toggle" /></ui:VisualElement>
                <ui:VisualElement name="Card 6" class="card"><ui:Label text="6" class="card-title" /><ui:Button name="press-6" text="Press" /></ui:VisualElement>
                <ui:VisualElement name="Card 7" class="card"><ui:Label text="7: .uf-no-drag" class="card-title" /><ui:VisualElement class="uf-no-drag nodrag"><ui:Label text="drag here does nothing" /></ui:VisualElement></ui:VisualElement>
                <ui:VisualElement name="Card 8" class="card"><ui:Label text="8" class="card-title" /><ui:Button name="press-8" text="Press" /></ui:VisualElement>
                <ui:VisualElement name="Card 9" class="card"><ui:Label text="9" class="card-title" /><ui:Button name="press-9" text="Press" /></ui:VisualElement>
                <ui:VisualElement name="Card 10" class="card"><ui:Label text="10" class="card-title" /><ui:Button name="press-10" text="Press" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label class="section" text="Card deck: steps one card, always rests on whole cards (.uf-card-deck)" />
        <ui:VisualElement name="deck" class="uf-card-deck deck">
            <ui:VisualElement class="uf-cards">
                <ui:VisualElement name="Deck A" class="card deck-card"><ui:Label text="A" class="card-title" /></ui:VisualElement>
                <ui:VisualElement name="Deck B" class="card deck-card"><ui:Label text="B" class="card-title" /></ui:VisualElement>
                <ui:VisualElement name="Deck C" class="card deck-card"><ui:Label text="C" class="card-title" /></ui:VisualElement>
                <ui:VisualElement name="Deck D" class="card deck-card"><ui:Label text="D" class="card-title" /></ui:VisualElement>
                <ui:VisualElement name="Deck E" class="card deck-card"><ui:Label text="E" class="card-title" /></ui:VisualElement>
                <ui:VisualElement name="Deck F" class="card deck-card"><ui:Label text="F" class="card-title" /></ui:VisualElement>
                <ui:VisualElement name="Deck G" class="card deck-card"><ui:Label text="G" class="card-title" /></ui:VisualElement>
                <ui:VisualElement name="Deck H" class="card deck-card"><ui:Label text="H" class="card-title" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label class="section" text="Vertical strip: free scrolling (--uf-axis: vertical)" />
        <ui:VisualElement name="list" class="uf-card-strip list">
            <ui:VisualElement name="list-rows" class="uf-cards" />
        </ui:VisualElement>
    </ui:VisualElement>

    <ui:VisualElement name="menu" class="uf-drawer menu">
        <ui:Label text="Drawer (--uf-edge: auto)" class="menu-title" />
        <ui:Button name="menu-a" text="Menu item A" />
        <ui:Button name="menu-b" text="Menu item B" />
        <ui:Button name="menu-c" text="Menu item C" />
        <ui:Label class="menu-note" text="Drag me, fling me, or click the handle." />
        <ui:VisualElement class="uf-drawer-handle menu-handle"><ui:Label text="≡" class="menu-handle-label" /></ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
